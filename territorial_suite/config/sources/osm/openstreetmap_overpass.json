    {
      "id": "osm.roads",
      "name": "Viabilita (OpenStreetMap)",
      "authority": "OpenStreetMap contributors",
      "country": "*",
      "scope": {
        "level": "global",
        "codes": []
      },
      "category": "roads",
      "subcategory": "highway",
      "type": "OVERPASS",
      "url": "https://overpass-api.de/api/interpreter",
      "layer": "lines",
      "crs": [
        "EPSG:4326"
      ],
      "geometry": "LineString",
      "query": {
        "osm_layer": "lines",
        "timeout": 45,
        "max_features": 50000,
        "filters": [
          "way[\"highway\"]"
        ],
        "min_interval_s": 2.0,
        "timeout_s": 60,
        "retries": 2
      },
      "fields": {
        "label": "name",
        "code": "osm_id",
        "class": "highway"
      },
      "evidence_level": "cartographic",
      "data_nature": "thematic",
      "verification_status": "verified",
      "verification_note": "Overpass 'out count' OK il 2026-09-17; le stesse query sono state eseguite negli scenari live del 2026-09-16.",
      "quality": {
        "score": 45,
        "completeness": "disomogenea",
        "currency": "aggiornamento continuo"
      },
      "coverage": {
        "completeness": "partial",
        "notes": "Dato collaborativo: la copertura dipende dai contributi locali e non e' omogenea. L'assenza di un elemento non significa che l'elemento non esista."
      },
      "update_frequency": "continuous",
      "last_verified": "2026-09-16",
      "license": "ODbL 1.0",
      "attribution": "(c) OpenStreetMap contributors, ODbL",
      "official": false,
